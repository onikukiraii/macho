# MySQL接続情報
MYSQL_USER=app
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=password
MYSQL_HOST=localhost
MYSQL_PORT=3309
MYSQL_DATABASE=mydatabase

# ホスト用DATABASE_URL（上記から自動生成も可能）
DATABASE_URL=mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}

# S3（ローカルは MinIO。本番は endpoint_url を空にして IAM ロールに任せる）
S3_BUCKET=app-local
S3_ENDPOINT_URL=http://localhost:9100
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# MinIO（コンテナ側の管理者資格情報）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=16000

# 非同期ジョブ
CELERY_BROKER_URL=redis://localhost:6399/0
