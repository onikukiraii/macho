# MySQL接続情報
MYSQL_USER=app
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=password
MYSQL_HOST=localhost
MYSQL_PORT=37306
MYSQL_DATABASE=mydatabase

# ホスト用DATABASE_URL（上記から自動生成も可能）
DATABASE_URL=mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}

# アプリ
APP_TIMEZONE=Asia/Tokyo

# Web Push。鍵は docs/deploy.md の手順で作る。空では起動しない
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 画面の配信。本番のイメージだけが設定する
# FRONTEND_DIST_DIR=/app/dist

# 非同期ジョブ
CELERY_BROKER_URL=redis://localhost:37379/0
